rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection: readable by authenticated users or backend functions
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || request.auth.token.role == 'admin';
    }
    
    // Reports collection: read/write based on role and status
    match /reports/{reportId} {
      allow read: if true;
      allow write: if true;
      
      // Subcollections for daily records and audit logs
      match /days/{dayId} {
        allow read, write: if true;
      }
      
      match /attachments/{attachmentId} {
        allow read, write: if true;
      }
      
      match /audit_logs/{logId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false; // Audit logs are immutable
      }
    }
  }
}
