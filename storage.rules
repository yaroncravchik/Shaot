rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{reportId}/{allPaths=**} {
      // Allow read for attachments
      allow read: if true;
      // Allow write up to 10MB per file with valid document/image content types
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                   || request.resource.contentType.matches('image/.*'));
    }
  }
}
